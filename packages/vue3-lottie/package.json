{
  "name": "vue3-lottie",
  "version": "4.0.0",
  "license": "MIT",
  "author": "Sanjay Soundarajan <info@sanjaysoundarajan.dev> (https://sanjaysoundarajan.dev)",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "dev:build": "vite build && tsc -d --emitDeclarationOnly && vue-typegen gen -s ./src -o ./dist",
    "prepublishOnly": "npm run build",
    "lint": "eslint \"{packages,playground}/**/*.{ts,tsx,vue,js,jsx,html}\"",
    "prettier": "npx prettier --write ."
  },
  "dependencies": {
    "fast-deep-equal": "3.1.3",
    "klona": "2.0.6",
    "lottie-web": "5.13.0"
  },
  "peerDependencies": {
    "vue": "^3.2"
  },
  "files": [
    "dist/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/megasanjay/vue3-lottie.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/vue3-lottie.cjs",
  "module": "dist/vue3-lottie.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/vue3-lottie.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/vue3-lottie.cjs"
      }
    },
    "./light": {
      "import": {
        "types": "./dist/light.d.ts",
        "default": "./dist/vue3-lottie-light.es.js"
      },
      "require": {
        "types": "./dist/light.d.cts",
        "default": "./dist/vue3-lottie-light.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@babel/types": "7.25.0",
    "@types/lodash-es": "4.17.12",
    "@types/node": "20.14.15",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/compiler-sfc": "3.5.44",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-css-injected-by-js": "5.0.3",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-vue-type-imports": "0.2.5",
    "vue": "3.5.44",
    "vue-tsc": "0.40.13",
    "vue-typegen": "0.2.0"
  },
  "bugs": {
    "url": "https://github.com/megasanjay/vue3-lottie/issues",
    "email": "info@sanjaysoundarajan.dev"
  },
  "engines": {
    "node": ">=14.16"
  },
  "homepage": "https://vue3-lottie.vercel.app/",
  "keywords": [
    "vue3",
    "lottie"
  ]
}